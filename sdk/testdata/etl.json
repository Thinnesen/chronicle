{
  "apiVersion": "chronicle.thinnesen.com/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "generateName": "etl-",
    "labels": {
      "team": "data"
    }
  },
  "spec": {
    "arguments": {
      "parameters": [
        {
          "name": "day",
          "value": "2026-10-17"
        }
      ]
    },
    "entrypoint": "main",
    "onExit": "notify",
    "parallelism": 4,
    "synchronization": {
      "mutex": {
        "name": "etl"
      }
    },
    "templates": [
      {
        "dag": {
          "tasks": [
            {
              "name": "fetch",
              "template": "fetch"
            },
            {
              "arguments": {
                "artifacts": [
                  {
                    "from": "{{tasks.fetch.outputs.artifacts.rows}}",
                    "name": "rows"
                  }
                ]
              },
              "continueOn": {
                "failed": true
              },
              "dependencies": [
                "fetch"
              ],
              "name": "count",
              "template": "count"
            },
            {
              "arguments": {
                "parameters": [
                  {
                    "name": "msg",
                    "value": "fetched {{tasks.fetch.outputs.result}} rows"
                  }
                ]
              },
              "dependencies": [
                "count"
              ],
              "name": "report",
              "onExit": {
                "arguments": {
                  "parameters": [
                    {
                      "name": "msg",
                      "value": "count was {{tasks.count.status}}"
                    }
                  ]
                },
                "template": "echo"
              },
              "template": "echo"
            },
            {
              "arguments": {
                "parameters": [
                  {
                    "name": "msg",
                    "value": "{{item}}"
                  }
                ]
              },
              "dependencies": [
                "count"
              ],
              "name": "parts",
              "template": "echo",
              "withSequence": {
                "count": "3",
                "format": "part-%d",
                "start": 1
              }
            }
          ]
        },
        "name": "main",
        "parallelism": 2
      },
      {
        "name": "fetch",
        "outputs": {
          "artifacts": [
            {
              "name": "rows",
              "path": "/tmp/rows"
            }
          ]
        },
        "retryStrategy": {
          "backoff": {
            "duration": "10s",
            "factor": 2
          },
          "limit": 2
        },
        "script": {
          "env": [
            {
              "name": "DAY",
              "value": "{{workflow.parameters.day}}"
            }
          ],
          "image": "busybox:1.37",
          "source": "mkdir -p /tmp/rows \u0026\u0026 echo \"$DAY\" \u003e /tmp/rows/day.txt \u0026\u0026 echo 1204"
        }
      },
      {
        "container": {
          "command": [
            "wc",
            "-l",
            "/tmp/in/day.txt"
          ],
          "image": "busybox:1.37"
        },
        "inputs": {
          "artifacts": [
            {
              "name": "rows",
              "path": "/tmp/in"
            }
          ]
        },
        "name": "count",
        "synchronization": {
          "mutex": {
            "name": "counter"
          }
        }
      },
      {
        "container": {
          "args": [
            "{{inputs.parameters.msg}}"
          ],
          "command": [
            "echo"
          ],
          "image": "busybox:1.37"
        },
        "inputs": {
          "parameters": [
            {
              "name": "msg"
            }
          ]
        },
        "name": "echo"
      },
      {
        "http": {
          "body": "{\"text\": \"{{workflow.name}} is {{workflow.status}}\"}",
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "valueFrom": {
                "secretKeyRef": {
                  "key": "token",
                  "name": "chat"
                }
              }
            }
          ],
          "method": "POST",
          "url": "https://chat.example.com/hooks/data"
        },
        "name": "notify"
      }
    ]
  }
}
