{
  "apiVersion": "chronicle.thinnesen.com/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "generateName": "etl-",
    "labels": {
      "team": "data"
    }
  },
  "spec": {
    "arguments": {
      "parameters": [
        {
          "name": "day",
          "value": "2026-10-17"
        }
      ]
    },
    "entrypoint": "main",
    "parallelism": 4,
    "synchronization": {
      "mutex": {
        "name": "etl"
      }
    },
    "templates": [
      {
        "dag": {
          "tasks": [
            {
              "name": "fetch",
              "template": "fetch"
            },
            {
              "arguments": {
                "artifacts": [
                  {
                    "from": "{{tasks.fetch.outputs.artifacts.rows}}",
                    "name": "rows"
                  }
                ]
              },
              "continueOn": {
                "failed": true
              },
              "dependencies": [
                "fetch"
              ],
              "name": "count",
              "template": "count"
            },
            {
              "arguments": {
                "parameters": [
                  {
                    "name": "msg",
                    "value": "fetched {{tasks.fetch.outputs.result}} rows"
                  }
                ]
              },
              "dependencies": [
                "count"
              ],
              "name": "report",
              "template": "echo"
            }
          ]
        },
        "name": "main",
        "parallelism": 2
      },
      {
        "name": "fetch",
        "outputs": {
          "artifacts": [
            {
              "name": "rows",
              "path": "/tmp/rows"
            }
          ]
        },
        "retryStrategy": {
          "backoff": {
            "duration": "10s",
            "factor": 2
          },
          "limit": 2
        },
        "script": {
          "env": [
            {
              "name": "DAY",
              "value": "{{workflow.parameters.day}}"
            }
          ],
          "image": "busybox:1.37",
          "source": "mkdir -p /tmp/rows \u0026\u0026 echo \"$DAY\" \u003e /tmp/rows/day.txt \u0026\u0026 echo 1204"
        }
      },
      {
        "container": {
          "command": [
            "wc",
            "-l",
            "/tmp/in/day.txt"
          ],
          "image": "busybox:1.37"
        },
        "inputs": {
          "artifacts": [
            {
              "name": "rows",
              "path": "/tmp/in"
            }
          ]
        },
        "name": "count"
      },
      {
        "container": {
          "args": [
            "{{inputs.parameters.msg}}"
          ],
          "command": [
            "echo"
          ],
          "image": "busybox:1.37"
        },
        "inputs": {
          "parameters": [
            {
              "name": "msg"
            }
          ]
        },
        "name": "echo"
      }
    ]
  }
}
